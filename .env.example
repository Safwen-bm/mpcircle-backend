# Local (non-Docker) Postgres connection, or the docker-compose "db" service.
# When running everything via `docker compose up`, this is set automatically
# in docker-compose.yml — you only need this file for `npm run dev` locally.
DATABASE_URL="postgresql://mpcircle:mpcircle@localhost:5432/mpcircle_dashboard?schema=public"

JWT_SECRET="dev_secret_change_me"
JWT_EXPIRES_IN="1h"

PORT=3000
NODE_ENV=development
