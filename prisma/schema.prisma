// MPCircle Student Dashboard - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// Mock-auth user. In a real system this would be tied to Student via a
// separate identity table, but for this screening task a flat User model
// is enough to demonstrate JWT auth end-to-end.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // bcrypt hash
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  email       String       @unique
  enrolledAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]

  @@index([lastName])
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String?
  credits     Int          @default(3)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]

  @@index([title])
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

model Assignment {
  id        String           @id @default(uuid())
  title     String
  status    AssignmentStatus @default(PENDING)
  dueDate   DateTime
  grade     Float?
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}
